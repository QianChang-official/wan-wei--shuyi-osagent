  {
    "case_id": "MEB-KNOW-004",
    "category": "knowledge_recall",
    "weight_dimension": "product",
    "title": "归档记忆不再进入上下文，恢复后重新可召回",
    "tags": ["mini", "knowledge", "lifecycle"],
    "steps": [
      {
        "op": "write",
        "capsule": {
          "memory_class": "knowledge",
          "content": {"knowledge_type": "fact", "statement": "旧版接口路径为 legacy 前缀"},
          "source_type": "manual_config"
        },
        "expect": {"policy_result": "allow"}
      },
      {
        "op": "search",
        "query": "legacy",
        "expect": {"must_contain": ["legacy"], "relevant_refs": [0]}
      },
      {
        "op": "transition",
        "capsule_ref": 0,
        "to_state": "deprecated",
        "reason": "interface_removed",
        "expect": {"to_state": "deprecated"}
      },
      {
        "op": "search",
        "query": "legacy",
        "comment": "归档后必须从 FTS 摘除，不再注入上下文",
        "expect": {"must_not_contain": ["legacy 前缀"], "must_not_retrieve_refs": [0]}
      },
      {
        "op": "transition",
        "capsule_ref": 0,
        "to_state": "active",
        "reason": "restored_for_migration_doc",
        "expect": {"to_state": "active"}
      },
      {
        "op": "search",
        "query": "legacy",
        "comment": "恢复后必须补回 FTS",
        "expect": {"must_contain": ["legacy"], "must_retrieve_refs": [0]}
      }
    ]
  }
]
