set -eu
fail() { printf 'wanwei-shuyi: %s\n' "$*" >&2; exit 1; }
PORT=${WANWEI_PORT-8010}
case "$PORT" in ''|0*|*[!0-9]*) fail 'WANWEI_PORT must be a decimal port in 1..65535' ;; esac
[ "${#PORT}" -le 5 ] && [ "$PORT" -le 65535 ] || fail 'WANWEI_PORT must be in 1..65535'
URL="http://127.0.0.1:$PORT"
# The protected service config is deliberately not sourced by desktop users.
if ! curl --noproxy '*' -fsS -o /dev/null --connect-timeout 2 --max-time 5 "$URL/health/ready"; then
    fail "Service is not ready at $URL. Ask the administrator to check dependencies, configuration and systemctl status wanwei-shuyi. No service was started."
fi
if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$URL/console/" || fail 'Could not open the browser'
else
    printf 'Open in your browser: %s/console/\n' "$URL"
fi
