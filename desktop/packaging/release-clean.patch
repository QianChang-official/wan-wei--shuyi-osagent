-    const rejected = r !== null && (r.ok === false || r.paired === false || r.verified === false || r.success === false)
-    if (rejected) throw new Error(pickStr(r, ['message', 'detail', 'error']) || '令牌未通过校验')
-    deviceName.value = r ? pickStr(r, ['device_name', 'device', 'name']) : ''
